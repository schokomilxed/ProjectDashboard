# Adresse deiner Baserow-Installation (ohne /api am Ende)
BASEROW_URL=https://baserow.example.com

# Datenbank-Token für den laufenden Betrieb (Zeilen lesen/schreiben).
# Anlegen in Baserow: Einstellungen → Datenbank-Tokens.
BASEROW_DATABASE_TOKEN=

# Nur für die Einrichtung (npm run setup): Benutzer mit Rechten zum Anlegen
# von Datenbanken, Tabellen und Feldern. Nach der Einrichtung wieder leeren.
BASEROW_EMAIL=
BASEROW_PASSWORD=

# Wo die Datenbank liegt. Gibt es nur einen Workspace, kann die ID leer bleiben.
BASEROW_WORKSPACE_ID=
# Entweder eine vorhandene Datenbank per ID oder per Name (wird sonst angelegt).
BASEROW_DATABASE_ID=
BASEROW_DATABASE_NAME=Steckbriefe

# Hier schreibt die Einrichtung die Tabellen- und Feld-IDs hin.
BASEROW_TABLES_FILE=baserow.tables.json
